{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zed-pkg.github.io/zed-sync/formal-app-lifecycle.schema.json",
  "title": "zed-sync formal app lifecycle refinement traces",
  "type": "object",
  "required": ["schema_version", "model", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "model": { "type": "string", "enum": ["app-lifecycle-v1"] },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["event", "outcome", "state"],
      "additionalProperties": false,
      "properties": {
        "event": { "$ref": "#/$defs/event" },
        "outcome": {
          "type": "string",
          "enum": ["applied", "stuttered", "stale", "rejected"]
        },
        "state": { "$ref": "#/$defs/state" }
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["start_requested"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "token"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["start_succeeded"] },
            "token": { "$ref": "#/$defs/token" }
          }
        },
        {
          "type": "object",
          "required": ["type", "token"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["start_failed"] },
            "token": { "$ref": "#/$defs/token" }
          }
        },
        {
          "type": "object",
          "required": ["type", "token", "online"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["connectivity_changed"] },
            "token": { "$ref": "#/$defs/token" },
            "online": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["type", "token"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["runtime_failed"] },
            "token": { "$ref": "#/$defs/token" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["stop_requested"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "token"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["stop_succeeded"] },
            "token": { "$ref": "#/$defs/token" }
          }
        },
        {
          "type": "object",
          "required": ["type", "token"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["stop_failed"] },
            "token": { "$ref": "#/$defs/token" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["reconcile_requested"] }
          }
        }
      ]
    },
    "token": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "state": {
      "type": "object",
      "required": ["phase", "operation", "generation", "active_token", "desired_running", "online", "failure"],
      "additionalProperties": false,
      "properties": {
        "phase": { "type": "string", "enum": ["stopped", "starting", "online", "offline", "stopping", "failed"] },
        "operation": { "type": "string", "enum": ["none", "start", "stop", "reconcile"] },
        "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "active_token": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
        "desired_running": { "type": "boolean" },
        "online": { "type": "boolean" },
        "failure": { "type": ["string", "null"], "enum": ["start", "runtime", "stop", null] }
      }
    }
  }
}
